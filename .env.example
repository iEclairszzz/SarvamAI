# Sarvam AI API Key (required)
SARVAM_API_KEY=your_sarvam_api_key_here

# Vercel Blob read-write token (required when deployed on Vercel)
# Create/link a Blob store with: vercel blob create-store <name> --access public --yes
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token_here

# Optional: override where generated WAV files are written.
# Defaults to ./outputs locally and /tmp/sarvam-narrator-outputs on Vercel.
# OUTPUTS_DIR=outputs
